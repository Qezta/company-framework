## Mermaid flowcharts of processes, for docs and READMEs.
{
  lib,
  config,
  ...
}: let
  cfg = config.company;
  esc = lib.replaceStrings ["\"" "\n"] ["#quot;" " "];
  shape = step: label:
    if step.kind == "decision"
    then "{\"${label}\"}"
    else if step.kind == "approval"
    then "[/\"${label}\"/]"
    else if step.kind == "automated"
    then "[[\"${label}\"]]"
    else "[\"${label}\"]";
  render = p:
    lib.concatLines (
      [
        "%% Generated by company-framework from the company spec. Do not edit by hand."
        "flowchart TD"
      ]
      ++ map (s: "  ${s.id}${shape s "${esc s.title}<br/><i>${esc s.role}</i>"}") p.steps
      ++ lib.concatMap (s: map (n: "  ${s.id} --> ${n}") s.next) p.steps
    );
in {
  options.company.exports.mermaid.enable = lib.mkOption {
    type = lib.types.bool;
    default = true;
    description = "Whether to export Mermaid process diagrams under `diagrams/`.";
  };

  config.output.files = lib.mkIf cfg.exports.mermaid.enable (lib.mapAttrs' (pid: p:
    lib.nameValuePair "diagrams/${pid}.mmd" {
      format = "text";
      value = render p;
    })
  cfg.processes);
}
