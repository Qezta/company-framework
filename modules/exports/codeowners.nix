## GitHub CODEOWNERS per repository, from `systems.<id>.codeowners`.
## Roles become `@Org/team` when mapped to a GitHub team, otherwise the
## GitHub logins of their current members.
{
  lib,
  config,
  companyLib,
  ...
}: let
  cfg = config.company;
  d = companyLib.derive cfg;

  rulesFor = repo: lib.concatMap (id: cfg.systems.${id}.codeowners) d.systemsByRepo.${repo};
  ownersOf = repo: rule: lib.unique (lib.concatMap (d.githubOwners (d.orgOf repo)) rule.owners);

  render = repo:
    lib.concatLines (
      [
        "# Generated by company-framework from the company spec. Do not edit by hand."
        "# Later rules take precedence over earlier ones."
      ]
      ++ map (rule: lib.concatStringsSep " " ([rule.pattern] ++ ownersOf repo rule)) (rulesFor repo)
    );

  ownerless = lib.concatMap (repo:
    map (rule: "CODEOWNERS for ${repo}: '${rule.pattern}' resolves to no GitHub owner (roles: ${lib.concatStringsSep ", " rule.owners})")
    (lib.filter (rule: ownersOf repo rule == []) (rulesFor repo)))
  (lib.attrNames d.systemsByRepo);
in {
  options.company.exports.codeowners.enable = lib.mkOption {
    type = lib.types.bool;
    default = true;
    description = "Whether to export CODEOWNERS files under `codeowners/<Org>/<repo>/`.";
  };

  config = lib.mkIf cfg.exports.codeowners.enable {
    output.files = lib.mapAttrs' (repo: _:
      lib.nameValuePair "codeowners/${repo}/CODEOWNERS" {
        format = "text";
        value = render repo;
      })
    d.systemsByRepo;
    warnings = ownerless;
  };
}
