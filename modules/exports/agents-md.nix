## Context files for AI agents: a company-wide AGENTS.md, one per repository,
## and llms.txt (https://llmstxt.org). These get synced into repositories that
## may be public, so they never include people's names or email addresses.
{
  lib,
  config,
  companyLib,
  ...
}: let
  cfg = config.company;
  d = companyLib.derive cfg;
  header = "> Generated by company-framework from the company spec. Do not edit by hand; change the spec and regenerate.";
  cell = lib.replaceStrings ["|" "\n"] ["\\|" " "];
  orDash = v:
    if v == null || v == [] || v == ""
    then "-"
    else if builtins.isList v
    then lib.concatStringsSep ", " v
    else v;
  table = cols: rows:
    lib.concatLines (
      ["| ${lib.concatStringsSep " | " cols} |" "| ${lib.concatStringsSep " | " (map (_: "---") cols)} |"]
      ++ map (r: "| ${lib.concatStringsSep " | " (map (c: cell (orDash c)) r)} |") rows
    );
  section = title: body: lib.optionalString (body != "") "\n## ${title}\n\n${body}";
  bullets = lib.concatMapStrings (l: "- ${l}\n");

  rolesTable = table ["Role" "Parent" "GitHub team" "Responsibilities"] (lib.mapAttrsToList (id: r: [
      "`${id}`"
      (lib.mapNullable (p: "`${p}`") r.parent)
      r.githubTeam
      r.responsibilities
    ])
    cfg.roles);

  systemsTable = table ["System" "Type" "Lifecycle" "Owner" "Repository"] (lib.mapAttrsToList (id: s: [
      "`${id}`"
      s.type
      s.lifecycle
      "`${s.owner}`"
      s.repo
    ])
    cfg.systems);

  policyLines = lib.mapAttrsToList (id: p:
    "**${p.title}** (`${id}`, owner `${p.owner}`)"
    + lib.optionalString (p.doc != null) ": `${p.doc}`")
  cfg.policies;

  processLines = lib.mapAttrsToList (id: p:
    "**${p.title}** (`${id}`, owner `${p.owner}`, ${p.trigger}): "
    + lib.concatMapStringsSep " → " (s: s.title) p.steps)
  cfg.processes;

  decisionLines = map (x: "**${x.title}** (`${x.file}`)${lib.optionalString (x.status != null) ": ${x.status}"}") cfg.decisions;

  company = ''
    # ${cfg.entity.name}: agent context

    ${header}

    ${cfg.entity.description}
    ${section "Company" (bullets ([
        "Legal name: ${cfg.entity.legalName}"
        "Jurisdiction: ${cfg.entity.jurisdiction}"
      ]
      ++ lib.optional (cfg.entity.domains != []) "Domains: ${lib.concatStringsSep ", " cfg.entity.domains}"
      ++ lib.optional (cfg.entity.contacts.security != null) "Security contact: ${cfg.entity.contacts.security}"))}${section "Roles" rolesTable}${section "Systems" systemsTable}${section "Policies" (bullets policyLines)}${section "Processes" (bullets processLines)}${section "Decisions" (bullets decisionLines)}'';

  repoDoc = repo: let
    ids = d.systemsByRepo.${repo};
    describe = id: let
      s = cfg.systems.${id};
      team = cfg.roles.${s.owner}.githubTeam or null;
    in
      ''
        ## `${id}`

        ${s.description}

      ''
      + bullets ([
          "Type: ${s.type}, lifecycle: ${s.lifecycle}"
          "Owner: role `${s.owner}`${lib.optionalString (team != null) " (GitHub team `@${d.orgOf repo}/${team}`)"}"
        ]
        ++ lib.optional (s.domain != null) "Domain: `${s.domain}`"
        ++ lib.optional (s.dependsOn != []) "Depends on: ${lib.concatMapStringsSep ", " (x: "`${x}`") s.dependsOn}");
  in ''
    # ${repo}: agent context

    ${header}

    This repository belongs to ${cfg.entity.name}. ${cfg.entity.description}

    ${lib.concatMapStringsSep "\n" describe ids}${section "Company policies" (bullets policyLines)}'';

  llms = let
    names = lib.attrNames config.output.files;
    has = n: builtins.elem n names;
    link = path: note: lib.optional (has path) "[${path}](${path}): ${note}";
  in ''
    # ${cfg.entity.name}

    > ${cfg.entity.description}

    Machine-readable description of the company, generated by company-framework.

    ## Specification

    ${bullets (
      link "spec.json" "the whole company spec as JSON"
      ++ link "agents/AGENTS.md" "company context for AI agents"
      ++ link "pricing.json" "plans and prices"
      ++ link "opa/data.json" "data for Open Policy Agent policies"
    )}
    ## Repositories

    ${bullets (map (repo: "[${repo}](agents/${repo}/AGENTS.md): ${lib.concatMapStringsSep "; " (id: cfg.systems.${id}.description) d.systemsByRepo.${repo}}") (lib.attrNames d.systemsByRepo))}'';
in {
  options.company.exports.agentsMd.enable = lib.mkOption {
    type = lib.types.bool;
    default = true;
    description = "Whether to export AGENTS.md files under `agents/` and `llms.txt`.";
  };

  config.output.files = lib.mkIf cfg.exports.agentsMd.enable (
    {
      "agents/AGENTS.md" = {
        format = "text";
        value = company;
      };
      "llms.txt" = {
        format = "text";
        value = llms;
      };
    }
    // lib.mapAttrs' (repo: _:
      lib.nameValuePair "agents/${repo}/AGENTS.md" {
        format = "text";
        value = repoDoc repo;
      })
    d.systemsByRepo
  );
}
