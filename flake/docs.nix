## docs/options.md, generated from option declarations and drift-checked.
{lib, ...}: let
  companyLib = import ../lib {inherit lib;};
  root = toString ../.;
  inherit ((companyLib.evalCompany {modules = [];})) options;
in {
  perSystem = {pkgs, ...}: let
    doc =
      (pkgs.nixosOptionsDoc {
        options = {inherit (options) company;};
        warningsAreErrors = true;
        ## Link declarations to the repository instead of store paths.
        transformOptions = opt:
          opt
          // {
            declarations =
              map (d: let
                rel = lib.removePrefix "${root}/" (toString d);
              in {
                name = rel;
                url = "https://github.com/Qezta/company-framework/blob/main/${rel}";
              })
              opt.declarations;
          };
      }).optionsCommonMark;

    page = pkgs.runCommand "options.md" {} ''
      {
        echo "# Options"
        echo
        echo "<!-- Generated by \`nix run .#update-docs\` from the option declarations. Do not edit by hand. -->"
        echo
        cat ${doc}
      } > $out
    '';
  in {
    packages.docs = page;

    apps.update-docs = {
      type = "app";
      program = lib.getExe (pkgs.writeShellScriptBin "update-docs" ''
        cp --no-preserve=mode ${page} "$(${pkgs.git}/bin/git rev-parse --show-toplevel)/docs/options.md"
      '');
      meta.description = "Regenerate docs/options.md";
    };

    checks.docs-drift = pkgs.runCommand "docs-drift" {} ''
      diff ${../docs/options.md} ${page} || {
        echo "Run: nix run .#update-docs && git add docs/options.md" >&2
        exit 1
      }
      touch $out
    '';
  };
}
