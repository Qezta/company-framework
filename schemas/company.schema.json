{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Qezta/company-framework/schemas/company.schema.json",
  "title": "Company spec",
  "description": "spec.json emitted by company-framework. Every option is always present; unset optional values are null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "asOf", "entity", "people", "roles", "domains", "systems"],
  "properties": {
    "specVersion": { "const": "0.1.0" },
    "asOf": { "$ref": "#/$defs/nullableDate" },
    "entity": { "$ref": "#/$defs/entity" },
    "people": { "type": "object", "additionalProperties": { "$ref": "#/$defs/person" } },
    "roles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/role" } },
    "domains": { "type": "object", "additionalProperties": { "$ref": "#/$defs/domain" } },
    "systems": { "type": "object", "additionalProperties": { "$ref": "#/$defs/system" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "nullableDate": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
    "nullableEmail": { "oneOf": [{ "$ref": "#/$defs/email" }, { "type": "null" }] },
    "nullableString": { "type": ["string", "null"] },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "legalName", "shortName", "description", "jurisdiction", "registration", "domains", "contacts", "links", "brand"],
      "properties": {
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "shortName": { "$ref": "#/$defs/nullableString" },
        "description": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "registration": { "$ref": "#/$defs/stringMap" },
        "domains": { "$ref": "#/$defs/stringList" },
        "contacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["general", "security", "legal", "privacy"],
          "properties": {
            "general": { "$ref": "#/$defs/nullableEmail" },
            "security": { "$ref": "#/$defs/nullableEmail" },
            "legal": { "$ref": "#/$defs/nullableEmail" },
            "privacy": { "$ref": "#/$defs/nullableEmail" }
          }
        },
        "links": { "$ref": "#/$defs/stringMap" },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colors", "fonts", "logo"],
          "properties": {
            "colors": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
            },
            "fonts": { "$ref": "#/$defs/stringMap" },
            "logo": { "$ref": "#/$defs/nullableString" }
          }
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "email", "githubUser", "roles", "status", "startDate", "endDate"],
      "properties": {
        "displayName": { "type": "string" },
        "email": { "$ref": "#/$defs/email" },
        "githubUser": { "$ref": "#/$defs/nullableString" },
        "roles": { "$ref": "#/$defs/stringList" },
        "status": { "enum": ["active", "onboarding", "offboarding", "former"] },
        "startDate": { "$ref": "#/$defs/nullableDate" },
        "endDate": { "$ref": "#/$defs/nullableDate" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "parent", "githubTeam", "githubPermission", "responsibilities"],
      "properties": {
        "description": { "type": "string" },
        "parent": { "$ref": "#/$defs/nullableString" },
        "githubTeam": { "$ref": "#/$defs/nullableString" },
        "githubPermission": { "enum": ["pull", "triage", "push", "maintain", "admin"] },
        "responsibilities": { "$ref": "#/$defs/stringList" }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "owner"],
      "properties": {
        "description": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "type", "lifecycle", "domain", "owner", "repo", "codeowners", "dependsOn", "links"],
      "properties": {
        "description": { "type": "string" },
        "type": { "enum": ["website", "service", "library", "infrastructure", "documentation", "tool"] },
        "lifecycle": { "enum": ["experimental", "production", "deprecated"] },
        "domain": { "$ref": "#/$defs/nullableString" },
        "owner": { "type": "string", "minLength": 1 },
        "repo": { "oneOf": [{ "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$" }, { "type": "null" }] },
        "codeowners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "owners"],
            "properties": {
              "pattern": { "type": "string" },
              "owners": { "$ref": "#/$defs/stringList" }
            }
          }
        },
        "dependsOn": { "$ref": "#/$defs/stringList" },
        "links": { "$ref": "#/$defs/stringMap" }
      }
    }
  }
}
